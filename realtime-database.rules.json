{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "requests": {
      ".read": "auth != null",
      ".indexOn": ["status", "hospitalUid"],
      "$requestId": {
        ".write": "auth != null && ((!data.exists() && newData.child('hospitalUid').val() === auth.uid) || (data.exists() && (data.child('hospitalUid').val() === auth.uid || newData.child('unitsPledged').exists())))",
        "unitsPledged": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
        }
      }
    },
    "pledges": {
      ".read": "auth != null",
      "$pledgeId": {
        ".write": "auth != null && !data.exists() && newData.child('donorUid').val() === auth.uid"
      }
    }
  }
}
